<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    OPTIONAL: Share build settings across all Broforce repos

    Place this file in the parent directory of all your Broforce repos.

    Setup:
    1. Copy this file to BroforceGlobal.props (same directory)
    2. Update settings below
    3. Add BroforceGlobal.props to parent directory's .gitignore (if tracked)

    Import chain: each repo's BroforceModBuild.targets imports this file from the repos
    parent directory first, then that repo's LocalBroforcePath.props. Settings in a repo's
    LocalBroforcePath.props override the ones here.
  -->

  <PropertyGroup>

    <!-- Broforce installation directory -->
    <BroforcePath>C:/Program Files (x86)/Steam/steamapps/common/Broforce</BroforcePath>

    <!-- For Thunderstore/r2modman: -->
    <!-- <BroforcePath>C:/Users/YourName/AppData/Roaming/r2modmanPlus-local/Broforce/profiles/Default/UMM</BroforcePath> -->

    <!-- Close game before build to prevent file locking (default: true) -->
    <CloseBroforceOnBuild>true</CloseBroforceOnBuild>

    <!-- Launch game via Steam after build (default: false) -->
    <LaunchBroforceOnBuild>false</LaunchBroforceOnBuild>

    <!-- Use hard links for ModContent files - faster but DLL always copied (default: false) -->
    <UseHardLinksForInstall>true</UseHardLinksForInstall>

    <!-- Show detailed build messages (default: false) -->
    <VerboseBuildOutput>false</VerboseBuildOutput>

    <!-- Game processes whose working directory is under it are not closed by the build -->
    <!-- <BroforceInstancesRoot>/path/to/instances</BroforceInstancesRoot> -->

    <!-- Library path for DLL references (adjust to your libs location) -->
    <LibPath>$(MSBuildThisFileDirectory)YourRepo/libs</LibPath>

    <!-- Point these to your installed mods (Thunderstore structure) -->
    <BroMakerLibPath>$(BroforcePath)/Mods/BroMaker-BroMaker/BroMakerLib/BroMakerLib.dll</BroMakerLibPath>
    <RocketLibPath>$(BroforcePath)/Mods/RocketLib-RocketLib/RocketLib/RocketLib.dll</RocketLibPath>
    <!-- If building from source repos: -->
    <!-- <BroMakerLibPath>$(MSBuildThisFileDirectory)Bro-Maker/BroMakerLib/_ModContent/BroMakerLib.dll</BroMakerLibPath> -->
    <!-- <RocketLibPath>$(MSBuildThisFileDirectory)RocketLib/RocketLib/_ModContent/RocketLib.dll</RocketLibPath> -->

  </PropertyGroup>

</Project>
