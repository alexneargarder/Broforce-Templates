# Makefile.common - Shared build infrastructure for Broforce mods
# Source: Broforce-Templates/Scripts/Makefile.common
# Synced to repos via sync-targets.sh

# Required variables (must be set before including this file):
#   PROJECT_NAME  - Display name for help text
#
# Build mode (set ONE before including):
#   SOLUTION      - Solution or project file to build (single/solution build)
#   AUTO_DISCOVER - Set to 1 to auto-discover projects matching Name/Name/Name.csproj
#   CUSTOM_BUILD  - Set to 1 to define your own build/clean/rebuild targets
#
# Optional variables:
#   EXTRA_HELP       - Additional help text. Must be a canned recipe (define ... endef) whose
#                      lines are @echo commands: it is expanded as recipe lines, so a plain
#                      string would be run as a command. Auto-generated with AUTO_DISCOVER.
#   EXCLUDE          - Projects to skip during discovery (AUTO_DISCOVER only). Space-separated;
#                      an entry matches either the project's directory/file name or its
#                      kebab-case target name (lowercase, spaces to hyphens). Quote entries
#                      containing spaces:
#                        EXCLUDE := ExampleMod "Bro Template" mission-impossibro
#   CLEANUP_SETTINGS - Path to ReSharper .DotSettings file (default: Scripts/BroforceMods.DotSettings)
#   CLEANUP_PROFILE  - Cleanup profile name (default: BroforceMods)
#   JB               - jb binary (default: jb; override for dotnet local tools: JB="dotnet jb")
#
# Command-line variables:
#   MSBUILD=<path>    - MSBuild binary to use
#   LAUNCH=no         - Don't kill or launch the game
#   INSTALL=no        - Don't copy built DLLs into the game directory
#   LAUNCH_ARGS="..." - Extra args forwarded to the launch command
#   PROJECT=<name>    - Scope the cleanup targets to one discovered project
#
# In AUTO_DISCOVER mode and with a .sln SOLUTION, `build` and `rebuild` build every project with
# launching disabled and then launch the game once through a separate `/t:LaunchOnly` MSBuild invocation.

# MSBuild configuration - override with: make MSBUILD="/path/to/msbuild" build
# Detect if running in WSL (Windows Subsystem for Linux)
IS_WSL := $(shell grep -qi microsoft /proc/version 2>/dev/null && echo 1)

ifdef IS_WSL
    # WSL: Use Windows MSBuild via /mnt/c path (override if your VS installation differs)
    MSBUILD ?= /mnt/c/Program Files/Microsoft Visual Studio/2022/Community/MSBuild/Current/Bin/MSBuild.exe
else
    # Native Linux/macOS/Windows: Use msbuild from PATH
    MSBUILD ?= msbuild
endif

MSBUILD_FLAGS := /p:Configuration=Release /verbosity:minimal /nologo

# LAUNCH variable controls both kill and launch behavior
# Usage: make build LAUNCH=no
ifeq ($(LAUNCH),no)
    LAUNCH_FLAGS := /p:CloseBroforceOnBuild=false /p:LaunchBroforceOnBuild=false
else
    LAUNCH_FLAGS := /p:CloseBroforceOnBuild=true /p:LaunchBroforceOnBuild=true
endif

# INSTALL variable controls whether DLL is copied to game directory
# Usage: make build INSTALL=no
ifeq ($(INSTALL),no)
    INSTALL_FLAGS := /p:SkipInstall=true
else
    INSTALL_FLAGS :=
endif

# LAUNCH_ARGS forwards extra args to the post-build launch command
# Usage: make build LAUNCH_ARGS="-m"
ifneq ($(strip $(LAUNCH_ARGS)),)
    LAUNCH_ARGS_FLAGS := /p:LaunchArgs="$(LAUNCH_ARGS)"
else
    LAUNCH_ARGS_FLAGS :=
endif

# Flags for the build half of build/rebuild: never launch from the build itself
ifeq ($(LAUNCH),no)
    _BUILD_ONLY_FLAGS := /p:CloseBroforceOnBuild=false /p:LaunchBroforceOnBuild=false
    _DO_LAUNCH :=
else
    _BUILD_ONLY_FLAGS := /p:CloseBroforceOnBuild=true /p:LaunchBroforceOnBuild=false
    _DO_LAUNCH := 1
endif

_NO_LAUNCH_FLAGS := /p:CloseBroforceOnBuild=false /p:LaunchBroforceOnBuild=false

# $(call _LAUNCH_ONLY,"<project>") - launch the game without building anything
_LAUNCH_ONLY = "$(MSBUILD)" $(1) /t:LaunchOnly $(MSBUILD_FLAGS) /p:CloseBroforceOnBuild=false /p:LaunchBroforceOnBuild=true $(LAUNCH_ARGS_FLAGS)

# Code cleanup configuration (JetBrains ReSharper CLI)
CLEANUP_SETTINGS ?= Scripts/BroforceMods.DotSettings
CLEANUP_PROFILE ?= BroforceMods
JB ?= jb

# For solution builds: extract first .csproj to use for single launch at end
# (avoids launching once per project in multi-project solutions)
# Format: Project("{GUID}") = "Name", "Path\To\Project.csproj", "{GUID}"
# Paths inside a .sln are relative to the .sln, so they are rebased onto its directory.
LAUNCH_PROJECT ?= $(shell d=$$(dirname $(SOLUTION)); \
  p=$$(grep -m1 '\.csproj"' $(SOLUTION) 2>/dev/null | sed 's/.*= "[^"]*", "\([^"]*\)".*/\1/; s/\\/\//g'); \
  if [ -n "$$p" ] && [ "$$d" != "." ]; then printf '%s/%s' "$$d" "$$p"; else printf '%s' "$$p"; fi)
# Quotes are stripped first so a quoted path with spaces is still recognised as a solution
IS_SOLUTION := $(filter %.sln,$(subst ",,$(SOLUTION)))

# Default target shows help
.DEFAULT_GOAL := help

# Auto-discover projects matching Name/Name/Name.csproj convention
ifdef AUTO_DISCOVER
CUSTOM_BUILD := 1

# _PROJ_PAIRS holds one "target=path" word per project; spaces in the path are encoded as
# 0x1f so each pair stays a single word for both make and the shell.
_US := $(shell printf '\037')

_PROJ_PAIRS := $(shell find . -maxdepth 3 -name '*.csproj' -type f 2>/dev/null | sort | \
  while IFS= read -r f; do \
    f="$${f#./}"; \
    stem=$$(basename "$$f" .csproj); \
    dir=$${f%%/*}; \
    parent=$$(basename "$$(dirname "$$f")"); \
    [ "$$dir" = "$$stem" ] && [ "$$parent" = "$$stem" ] || continue; \
    target=$$(printf '%s' "$$stem" | tr '[:upper:]' '[:lower:]' | tr ' ' '-'); \
    skip=false; \
    for ex in $(EXCLUDE); do \
      { [ "$$ex" = "$$stem" ] || [ "$$ex" = "$$target" ]; } && skip=true; \
    done; \
    $$skip || printf '%s=%s\n' "$$target" "$$(printf '%s' "$$f" | tr ' ' '\037')"; \
  done)

DISCOVER_TARGETS := $(foreach p,$(_PROJ_PAIRS),$(firstword $(subst =, ,$(p))))

# $(call _csproj_for,<target>) - decoded .csproj path for one discovered target
_csproj_for = $(subst $(_US), ,$(patsubst $(1)=%,%,$(filter $(1)=%,$(_PROJ_PAIRS))))

_FIRST_CSPROJ := $(call _csproj_for,$(firstword $(DISCOVER_TARGETS)))

# Shell snippet emitting "target<TAB>csproj" (spaces decoded) for every discovered project.
# The \# escape keeps make from reading the rest of the line as a comment.
_EACH_PROJECT = for p in $(_PROJ_PAIRS); do printf '%s\t%s\n' "$${p%%=*}" "$$(printf '%s' "$${p\#*=}" | tr '\037' ' ')"; done

define _BUILD_EACH
@$(_EACH_PROJECT) | cut -f2 | while IFS= read -r csproj; do \
  "$(MSBUILD)" "$$csproj" $(MSBUILD_FLAGS) $(1) $(INSTALL_FLAGS) $(LAUNCH_ARGS_FLAGS) || exit 1; \
done
endef

define _CLEAN_EACH
@$(_EACH_PROJECT) | cut -f2 | while IFS= read -r csproj; do \
  "$(MSBUILD)" "$$csproj" /t:Clean $(MSBUILD_FLAGS) $(INSTALL_FLAGS) $(LAUNCH_ARGS_FLAGS) || exit 1; \
done
endef

define _DISCOVER_BUILD
$(call _BUILD_EACH,$(_BUILD_ONLY_FLAGS))
$(if $(_DO_LAUNCH),@$(call _LAUNCH_ONLY,"$(_FIRST_CSPROJ)"))
endef

define EXTRA_HELP
	@echo "Individual projects:"
	@for t in $(DISCOVER_TARGETS); do echo "  make $$t"; done
	@test -n "$(strip $(DISCOVER_TARGETS))" || echo "  (none discovered)"
endef

ifneq ($(strip $(DISCOVER_TARGETS)),)
.PHONY: $(DISCOVER_TARGETS)
$(DISCOVER_TARGETS):
	@"$(MSBUILD)" "$(call _csproj_for,$@)" $(MSBUILD_FLAGS) $(LAUNCH_FLAGS) $(INSTALL_FLAGS) $(LAUNCH_ARGS_FLAGS)
endif

ifeq ($(strip $(_PROJ_PAIRS)),)

# Nothing discovered: fail before running MSBuild. `make help` still works.
.PHONY: build build-no-launch clean rebuild
build build-no-launch clean rebuild:
	@echo "Error: no projects matching Name/Name/Name.csproj found"
	@exit 1

else

.PHONY: build
build:
	$(_DISCOVER_BUILD)

.PHONY: build-no-launch
build-no-launch:
	$(call _BUILD_EACH,$(_NO_LAUNCH_FLAGS))

.PHONY: clean
clean:
	$(_CLEAN_EACH)

.PHONY: rebuild
rebuild: clean
	$(_DISCOVER_BUILD)

endif # discovery non-empty

endif # AUTO_DISCOVER

# Solution mode has no discovery table; keep the cleanup recipes syntactically valid
ifndef AUTO_DISCOVER
_EACH_PROJECT = printf ''
endif

# Code cleanup targets
_CHECK_JB = @command -v $(firstword $(JB)) >/dev/null 2>&1 || { \
	echo "Error: '$(firstword $(JB))' not found."; \
	echo "Install with: dotnet tool install -g JetBrains.ReSharper.GlobalTools"; \
	exit 1; }
_CHECK_SETTINGS = @test -f "$(CLEANUP_SETTINGS)" || { \
	echo "Error: $(CLEANUP_SETTINGS) not found."; \
	echo "Copy it from the Broforce-Templates repo: cp <Broforce-Templates>/Scripts/BroforceMods.DotSettings $(CLEANUP_SETTINGS)"; \
	exit 1; }

ifdef AUTO_DISCOVER
ifdef PROJECT
_CLEANUP_LIST_CMD = $(_EACH_PROJECT) | awk -F'\t' '$$1 == "$(PROJECT)" {print $$2}'
else
_CLEANUP_LIST_CMD = $(_EACH_PROJECT) | cut -f2
endif
else
_CLEANUP_LIST_CMD = printf '%s\n' $(SOLUTION)
endif

_CLEANUP_PREFLIGHT = @L=$$($(_CLEANUP_LIST_CMD) 2>/dev/null); \
	if [ -z "$$L" ]; then \
	  if [ -n "$(PROJECT)" ]; then \
	    echo "Error: PROJECT='$(PROJECT)' not found. Run 'make help' to list available projects."; \
	  else \
	    echo "Error: no cleanup targets. Set SOLUTION or AUTO_DISCOVER before including Makefile.common."; \
	  fi; \
	  exit 1; \
	fi

# jb cleanupcode needs a .sln for full C# transforms; a bare .csproj gets reformat-only.
# Map .csproj → sibling .sln when one exists; skip with a warning otherwise.
_RESOLVE_CLEANUP_TARGETS = while IFS= read -r f; do \
	  case "$$f" in \
	    *.sln) echo "$$f" ;; \
	    *.csproj) \
	      sln="$$(dirname "$$(dirname "$$f")")/$$(basename "$$f" .csproj).sln"; \
	      if [ -f "$$sln" ]; then echo "$$sln"; \
	      else echo "Skipping $$f: no sibling .sln found" >&2; fi ;; \
	    *) echo "$$f" ;; \
	  esac; \
	done

.PHONY: cleanup
cleanup:
	$(_CHECK_JB)
	$(_CHECK_SETTINGS)
	$(_CLEANUP_PREFLIGHT)
	@if [ -n "$(AUTO_DISCOVER)" ] && [ -z "$(PROJECT)" ] && [ -z "$(ALL)" ]; then \
	  echo "Error: unscoped 'make cleanup' touches every project in this repo."; \
	  echo "  Scope to one project:  make cleanup PROJECT=<name>"; \
	  echo "  Or opt into all:       make cleanup ALL=1"; \
	  exit 1; \
	fi
	@$(_CLEANUP_LIST_CMD) | $(_RESOLVE_CLEANUP_TARGETS) | while IFS= read -r t; do \
	  echo "Cleaning up $$t..."; \
	  $(JB) cleanupcode "$$t" --settings="$(CLEANUP_SETTINGS)" --profile="$(CLEANUP_PROFILE)" || exit 1; \
	done

.PHONY: cleanup-changed
cleanup-changed:
	$(_CHECK_JB)
	$(_CHECK_SETTINGS)
	$(_CLEANUP_PREFLIGHT)
	@FILES=$$(git diff --name-only --diff-filter=ACMR HEAD -- '*.cs'); \
	if [ -z "$$FILES" ]; then \
	  echo "No changed .cs files."; \
	  exit 0; \
	fi; \
	AUTO_PROJECT=; \
	if [ -z "$(PROJECT)" ] && [ -n "$(AUTO_DISCOVER)" ]; then \
	  DIRS=$$(echo "$$FILES" | awk -F/ '{print $$1}' | sort -u); \
	  if [ "$$(echo "$$DIRS" | wc -l)" = "1" ]; then \
	    AUTO_PROJECT=$$($(_EACH_PROJECT) | awk -F'\t' -v d="$$DIRS" '{ split($$2, p, "/"); if (p[1] == d) {print $$1; exit} }'); \
	    [ -n "$$AUTO_PROJECT" ] && echo "Auto-detected PROJECT=$$AUTO_PROJECT from changed files."; \
	  fi; \
	fi; \
	if [ -n "$$AUTO_PROJECT" ]; then \
	  LIST=$$($(_EACH_PROJECT) | awk -F'\t' -v p="$$AUTO_PROJECT" '$$1 == p {print $$2}'); \
	else \
	  LIST=$$($(_CLEANUP_LIST_CMD) 2>/dev/null); \
	fi; \
	echo "$$LIST" | $(_RESOLVE_CLEANUP_TARGETS) | while IFS= read -r t; do \
	  dir="$$(dirname "$$t")"; \
	  if [ "$$dir" = "." ]; then \
	    SCOPED="$$FILES"; \
	  else \
	    SCOPED=$$(echo "$$FILES" | awk -v d="$$dir/" 'index($$0, d) == 1 { print substr($$0, length(d)+1) }'); \
	  fi; \
	  if [ -z "$$SCOPED" ]; then \
	    echo "No changed .cs files in $$t."; continue; \
	  fi; \
	  INCL=$$(echo "$$SCOPED" | paste -sd';' -); \
	  echo "Cleaning up changed files in $$t..."; \
	  $(JB) cleanupcode "$$t" --settings="$(CLEANUP_SETTINGS)" --profile="$(CLEANUP_PROFILE)" --include="$$INCL" || exit 1; \
	done

.PHONY: help
help:
	@echo "$(PROJECT_NAME) Build System"
	@echo ""
	@echo "Targets:"
	@echo "  make build              Build all projects"
	@echo "  make build-no-launch    Build without disrupting running game"
	@echo "  make clean              Clean build artifacts"
	@echo "  make rebuild            Clean, then build all projects"
	@echo "  make cleanup            Run ReSharper code cleanup on all code"
	@echo "  make cleanup-changed    Run ReSharper code cleanup on git-changed files"
ifdef EXTRA_HELP
	@echo ""
	@$(EXTRA_HELP)
endif
	@echo ""
	@echo "Options:"
	@echo "  LAUNCH=no               Don't kill or launch game"
	@echo "  INSTALL=no              Don't copy DLL to game directory"
	@echo "  LAUNCH_ARGS=\"...\"       Forward extra args to the launch command"
	@echo "  PROJECT=<name>          Scope cleanup to one project (AUTO_DISCOVER only)"
	@echo ""
	@echo "Examples:"
	@echo "  make build                  Build everything and launch the game"
	@echo "  make build LAUNCH=no        Build without disrupting running game"
	@echo "  make build INSTALL=no       Build without installing to game"

# Build targets - can be overridden by setting CUSTOM_BUILD=1 before including
ifndef CUSTOM_BUILD

ifdef IS_SOLUTION
# Solution build: build all with launching disabled, then launch once via LaunchOnly
define _SOLUTION_BUILD
"$(MSBUILD)" $(SOLUTION) $(MSBUILD_FLAGS) $(_BUILD_ONLY_FLAGS) $(INSTALL_FLAGS) $(LAUNCH_ARGS_FLAGS)
$(if $(_DO_LAUNCH),$(if $(strip $(LAUNCH_PROJECT)),$(call _LAUNCH_ONLY,"$(LAUNCH_PROJECT)"),@echo "Error: no project found in $(SOLUTION) to launch"; exit 1))
endef
else
# Single project build: the build itself launches
define _SOLUTION_BUILD
"$(MSBUILD)" $(SOLUTION) $(MSBUILD_FLAGS) $(LAUNCH_FLAGS) $(INSTALL_FLAGS) $(LAUNCH_ARGS_FLAGS)
endef
endif

.PHONY: build
build:
	$(_SOLUTION_BUILD)

.PHONY: build-no-launch
build-no-launch:
	"$(MSBUILD)" $(SOLUTION) $(MSBUILD_FLAGS) $(_NO_LAUNCH_FLAGS) $(INSTALL_FLAGS) $(LAUNCH_ARGS_FLAGS)

.PHONY: clean
clean:
	"$(MSBUILD)" $(SOLUTION) /t:Clean $(MSBUILD_FLAGS) $(INSTALL_FLAGS) $(LAUNCH_ARGS_FLAGS)

.PHONY: rebuild
rebuild: clean
	$(_SOLUTION_BUILD)
endif
